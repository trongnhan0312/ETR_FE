# ETR Aviation Training - Frontend Environment Variables Template
# Copy this file to '.env' and modify the values as needed.

# Application General Config
VITE_APP_TITLE="ETR Aviation Training Portal"
VITE_APP_ENV="development"

# API Service URL (Backend Endpoint)
# For local development, prefer local backend first; if it is unavailable, the app will fall back to deploy.
VITE_API_URL_LOCAL="https://localhost:7169/api"
VITE_API_URL_DEPLOY="https://etrmanagement-be-fwhvagaxf3f3dmf0.southeastasia-01.azurewebsites.net/api"
VITE_API_URL="https://localhost:7169/api"

# Other configuration (e.g., Timeout in milliseconds)
VITE_API_TIMEOUT=10000
