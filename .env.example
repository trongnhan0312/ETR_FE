[TEMPLATE]
# ETR Aviation Training - Frontend Environment Variables Template

# ============================================================
# QUY TRÌNH API URL (CHỈ gọi API deploy):
#
# src/utils/api.js LUÔN gọi đúng 1 base URL DEPLOY (Azure) —
# ở cả `npm run dev` lẫn build production. KHÔNG còn API local / fallback.
#
# Muốn trỏ sang backend deploy khác, chỉ cần đổi VITE_API_URL_DEPLOY dưới đây.
# ============================================================

# ---------- API DEPLOY (bắt buộc; dùng cho cả dev lẫn Vercel build) ----------
# Backend đã deploy (Azure / Vercel / nơi khác):
VITE_API_URL_DEPLOY="https://etrmanagement-be-fwhvagaxf3f3dmf0.southeastasia-01.azurewebsites.net/api"

# ---------- Cấu hình khác ----------
VITE_APP_TITLE="ETR Aviation Training Portal"
VITE_APP_ENV="development"
VITE_API_TIMEOUT=10000

# ---------- Cloudinary (lưu trữ minh chứng — evidence) ----------
# FE upload thẳng file lên Cloudinary (unsigned upload preset) rồi chỉ gửi
# URL + metadata về BE (POST /Evidences/upload dạng JSON). BE không nhận byte file.
# Bắt buộc cấu hình 2 biến dưới đây thì tính năng tải lên minh chứng mới hoạt động.
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
