[TEMPLATE]
# ETR Aviation Training - Frontend Environment Variables Template

# ============================================================
# QUY TRÌNH API URL (dev vs deploy):
#
# 1. `npm run dev` (máy local)      → dùng API LOCAL  → file: .env.local  (KHÔNG commit)
# 2. push lên git → Vercel auto-build → dùng API DEPLOY → file: .env.production (CÓ commit)
#
# Vercel chạy `npm run build` = mode production → import.meta.env.PROD = true
# nên src/utils/api.js chỉ gọi API_DEPLOY, không bao giờ gọi localhost.
# ============================================================

# ---------- API LOCAL (chỉ cho dev; copy vào .env.local, KHÔNG commit) ----------
# Backend chạy trên máy bạn, đổi cổng ở đây nếu cần:
VITE_API_URL_LOCAL="https://localhost:7169/api"

# ---------- API DEPLOY (cho Vercel build; nằm trong .env.production, CÓ commit) ----------
# Backend đã deploy (Azure / Vercel / nơi khác):
VITE_API_URL_DEPLOY="https://etrmanagement-be-fwhvagaxf3f3dmf0.southeastasia-01.azurewebsites.net/api"

# ---------- Cấu hình khác ----------
VITE_APP_TITLE="ETR Aviation Training Portal"
VITE_APP_ENV="development"
VITE_API_URL="https://localhost:7169/api"
VITE_API_TIMEOUT=10000
